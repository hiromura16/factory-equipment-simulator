{
  "name": "プレス機 / 6台 / OPC UAとModbus",
  "description": "【想定】プレス機6台の温度・回転数・状態・ショット数を収集クライアントが読む。\n【異常】記録位置120〜179（約20〜29tick目）で温度がドリフトする。",
  "profile_id": "default",
  "interval_ms": 1000,
  "max_ticks": 2,
  "generator": {
    "run_key": "press-001",
    "seed": 3,
    "fields": [
      {
        "name": "id",
        "data_type": "string",
        "generator": "record_id",
        "primary_key": true,
        "length": 64
      },
      {
        "name": "temperature",
        "data_type": "number",
        "generator": "normal",
        "mean": 42.0,
        "stddev": 0.8,
        "scale": 2
      },
      {
        "name": "rpm",
        "data_type": "integer",
        "generator": "integer",
        "minimum": 1180,
        "maximum": 1220
      },
      {
        "name": "status",
        "data_type": "string",
        "generator": "choice",
        "choices": [
          "RUN",
          "IDLE",
          "ALARM"
        ],
        "weights": [
          94,
          5,
          1
        ],
        "length": 8
      },
      {
        "name": "shot_count",
        "data_type": "integer",
        "generator": "sequence"
      }
    ],
    "anomalies": [
      {
        "name": "温度ドリフト",
        "field": "temperature",
        "operation": "ramp",
        "value": 0.2,
        "from_row": 120,
        "to_row": 179
      }
    ]
  },
  "equipment": {
    "devices": 6,
    "registers": [
      {
        "field": "temperature",
        "area": "holding",
        "address": 0,
        "encoding": "float32"
      },
      {
        "field": "rpm",
        "area": "holding",
        "address": 2,
        "encoding": "uint16"
      },
      {
        "field": "status",
        "area": "holding",
        "address": 3,
        "encoding": "uint16",
        "enum_values": {
          "RUN": 0,
          "IDLE": 1,
          "ALARM": 2
        }
      },
      {
        "field": "shot_count",
        "area": "holding",
        "address": 4,
        "encoding": "uint32"
      }
    ]
  }
}
